<Window x:Class="Taskato.Views.WebShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Taskato" Icon="/Taskato;component/Assets/icon.png"
        Width="1280" Height="820" MinWidth="960" MinHeight="640"
        WindowStyle="None" ResizeMode="CanResize" Background="#11111F"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="#11111F"/>
        <Border x:Name="LoadingPanel" Background="#11111F">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="220" Height="4" IsIndeterminate="True" Foreground="#7775F5"/>
                <TextBlock Text="正在加载 Taskato 工作区…" Foreground="#AAAABE" Margin="0,18,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        <Border x:Name="ErrorPanel" Background="#11111F" Visibility="Collapsed">
            <StackPanel Width="480" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Web 工作区暂时无法启动" Foreground="#F1F1F7" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ErrorMessage" Foreground="#AAAABE" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22" Margin="0,14,0,24"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="重试" Click="RetryButton_Click" Padding="18,9"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
