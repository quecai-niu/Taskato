<UserControl x:Class="Taskato.Views.Pages.TaskWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="Workspace_PreviewKeyDown">
    <Grid Margin="24,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid>
                <Border Background="#0DFFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="13"/>
                <TextBox x:Name="TaskInput" Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                         Padding="16,11" FontSize="14" AcceptsReturn="True" MaxHeight="82"
                         KeyDown="TaskInput_KeyDown" ToolTip="输入任务；Enter 添加，Shift+Enter 换行，Tab 切换优先级"/>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <Border Background="#16FFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,8,0">
                    <TextBlock Text="{Binding NewTaskPriority, StringFormat=优先级 {0}}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
                <Button Content="添加任务" Command="{Binding AddTaskCommand}" Style="{StaticResource PrimaryButton}" Padding="18,10"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="260"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition x:Name="PomodoroSpacerColumn" Width="10"/>
                <ColumnDefinition x:Name="PomodoroColumn" Width="300" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource WorkspaceCard}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="任务树" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding DateLabelText}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CompletedCount, StringFormat={}{0} 已完成}" Foreground="{DynamicResource ThemePrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="{Binding TaskTreeExpansionLabel}"
                                    Command="{Binding ToggleAllTaskExpansionCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="9,4"/>
                        </StackPanel>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding TodayTasks}" SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Margin="-8,14,-8,-8"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="{Binding IndentWidth, Converter={StaticResource DoubleToLeftMarginConverter}}">
                                    <Border x:Name="TaskCard" CornerRadius="10" Padding="7" Margin="0,2" Background="Transparent"
                                            MouseLeftButtonDown="TaskCard_MouseLeftButtonDown">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Button Content="›" Command="{Binding DataContext.ToggleTaskExpansionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding HasVisibleChildren, Converter={StaticResource BoolToVisibilityConverter}}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMutedBrush}" Padding="0"/>
                                            <Border Grid.Column="1" Width="16" Height="16" CornerRadius="8" BorderThickness="1.5" BorderBrush="{DynamicResource ThemePrimaryBrush}"
                                                    Background="Transparent" MouseLeftButtonDown="Checkbox_Click" Tag="{Binding}">
                                                <TextBlock Text="✓" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </Border>
                                            <StackPanel Grid.Column="2" Margin="4,0,6,0">
                                                <TextBlock Text="{Binding DisplayTitle}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding ProgressDisplay}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"
                                                           Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </StackPanel>
                                            <Button Grid.Column="3" Content="＋" ToolTip="添加子任务" Visibility="{Binding CanAddChild, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.AddChildTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemePrimaryBrush}" Padding="5"/>
                                            <Button Grid.Column="4" Content="×" ToolTip="删除任务" Click="DeleteTask_Click" Tag="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMutedBrush}" Padding="5"/>
                                        </Grid>
                                    </Border>
                                    <TextBox Text="{Binding NewChildTitle, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding}" Margin="24,3,4,7" Padding="9,6"
                                             Visibility="{Binding IsAddingChild, Converter={StaticResource BoolToVisibilityConverter}}"
                                             KeyDown="ChildTaskInput_KeyDown" IsVisibleChanged="ChildTaskInput_IsVisibleChanged" ToolTip="Enter 添加，Esc 取消"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource WorkspaceCard}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="当前任务" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Row="1" Text="{Binding SelectedTask.DisplayTitle, TargetNullValue=请选择左侧任务}" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,18"/>
                    <StackPanel Grid.Row="2">
                        <Border Background="#0CFFFFFF" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <TextBlock Text="子任务" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding SelectedTask.Children}">
                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayTitle}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,5" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="＋ 添加子任务" Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding AddChildTaskCommand}" CommandParameter="{Binding SelectedTask}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="双击任务可打开完整详情" Foreground="{DynamicResource TextMutedBrush}"/>
                </Grid>
            </Border>

            <Border x:Name="PomodoroPanel" Grid.Column="4" Style="{StaticResource WorkspaceCard}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="专注计时" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="＋" ToolTip="添加番茄钟" Command="{Binding AddAdditionalTimerCommand}" Style="{StaticResource SecondaryButton}" Padding="7,3"/>
                    </Grid>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ComboBox ItemsSource="{Binding AllTimers}" SelectedItem="{Binding CurrentActiveTimer}" DisplayMemberPath="TimerName" MinWidth="130" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding CurrentActiveTimer.TimerDisplay}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="48" FontWeight="Light" Margin="0,8"/>
                        <TextBlock Text="{Binding CurrentActiveTimer.StatusText}" Foreground="{DynamicResource ThemePrimaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <ProgressBar Grid.Row="2" Value="{Binding CurrentActiveTimer.Progress}" Maximum="1" Height="5" Margin="0,0,0,18" Foreground="{DynamicResource ThemePrimaryBrush}"/>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="开始" Command="{Binding CurrentActiveTimer.StartWorkCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,7,0"/>
                        <Button Content="暂停" Command="{Binding CurrentActiveTimer.PauseCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,7,0"/>
                        <Button Content="停止" Command="{Binding CurrentActiveTimer.StopCommand}" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
