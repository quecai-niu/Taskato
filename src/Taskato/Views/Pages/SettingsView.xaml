<UserControl x:Class="Taskato.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="设置" Style="{StaticResource WorkspaceTitle}"/>
            <TextBlock Text="专注、提醒、主题与集成" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,22,0,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Style="{StaticResource WorkspaceCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="番茄钟" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
                            <TextBlock Text="专注分钟" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBox Text="{Binding WorkMinutes}" Padding="10,7" Margin="0,5,0,12"/>
                            <TextBlock Text="休息分钟" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBox Text="{Binding RestMinutes}" Padding="10,7" Margin="0,5,0,12"/>
                            <CheckBox Content="自动开始下一轮专注" IsChecked="{Binding AutoStartNextPomodoro}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,5"/>
                            <CheckBox Content="启用多组番茄钟" IsChecked="{Binding EnableMultiplePomodoros}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,5"/>
                            <CheckBox Content="提醒弹窗显示计时" IsChecked="{Binding EnableToastTimer}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,5"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource WorkspaceCard}">
                        <StackPanel>
                            <TextBlock Text="每日总结" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <CheckBox Content="跨天时自动显示昨日总结" IsChecked="{Binding AutoShowDailySummary}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource WorkspaceCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="主题" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
                            <TextBlock Text="主色（#RRGGBB）" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBox Text="{Binding ThemePrimaryColor}" Padding="10,7" Margin="0,5,0,12"/>
                            <TextBlock Text="渐变辅色（#RRGGBB）" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBox Text="{Binding ThemeSecondaryColor}" Padding="10,7" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource WorkspaceCard}">
                        <StackPanel>
                            <TextBlock Text="飞书通知" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
                            <CheckBox Content="启用飞书通知" IsChecked="{Binding FeishuEnabled}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            <TextBlock Text="Webhook URL" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBox Text="{Binding FeishuWebhookUrl}" Padding="10,7" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <Grid Grid.Row="2">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource ThemePrimaryBrush}" VerticalAlignment="Center"/>
            <Button Content="保存设置" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Padding="22,10"/>
        </Grid>
    </Grid>
</UserControl>
