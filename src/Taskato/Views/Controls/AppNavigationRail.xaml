<UserControl x:Class="Taskato.Views.Controls.AppNavigationRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="180">
    <Border Background="#B5121520" BorderBrush="#20FFFFFF" BorderThickness="0,0,1,0">
        <Grid Margin="16,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="10"
                        Background="{DynamicResource ThemeGradientBrush}">
                    <TextBlock Text="✦" FontSize="17" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Taskato" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="专注工作区" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <Button Style="{StaticResource WorkspaceNavButton}" Content="▣   任务"
                        Command="{Binding ShowTasksCommand}" Tag="{Binding IsTasksActive}"/>
                <Button Style="{StaticResource WorkspaceNavButton}" Content="◫   每日总结"
                        Command="{Binding ShowDailySummaryCommand}" Tag="{Binding IsDailySummaryActive}"/>
                <Button Style="{StaticResource WorkspaceNavButton}" Content="◷   历史记录"
                        Command="{Binding ShowHistoryCommand}" Tag="{Binding IsHistoryActive}"/>
            </StackPanel>

            <Button Grid.Row="4" Style="{StaticResource WorkspaceNavButton}" Content="⚙   设置"
                    Command="{Binding ShowSettingsCommand}" Tag="{Binding IsSettingsActive}"/>
        </Grid>
    </Border>
</UserControl>
