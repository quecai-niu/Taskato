<Window x:Class="Taskato.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Taskato.Views.Controls"
        xmlns:pages="clr-namespace:Taskato.Views.Pages"
        xmlns:utils="clr-namespace:Taskato.Utils"
        Title="Taskato" Icon="/Taskato;component/Assets/icon.png"
        Width="1280" Height="820" MinWidth="960" MinHeight="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="54" ResizeBorderThickness="12" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource MainWindowBorderStyle}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Border Background="#A90F1119" BorderBrush="#18FFFFFF" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,14,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource JellyCapsuleStyle}" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="min" Style="{StaticResource JellyWinBtn}" Click="MinimizeButton_Click"/>
                            <Button Content="max" Style="{StaticResource JellyWinBtn}" Click="MaximizeButton_Click"/>
                            <Button Content="exit" Style="{StaticResource JellyWinCloseBtn}" Click="CloseButton_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <controls:AppNavigationRail Grid.Column="0"/>

                <pages:TaskWorkspaceView Grid.Column="1" DataContext="{Binding TaskWorkspace}"
                    Visibility="{Binding DataContext.IsTasksActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <pages:DailySummaryView Grid.Column="1" DataContext="{Binding DailySummary}"
                    Visibility="{Binding DataContext.IsDailySummaryActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <pages:HistoryView Grid.Column="1" DataContext="{Binding History}"
                    Visibility="{Binding DataContext.IsHistoryActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <pages:SettingsView Grid.Column="1" DataContext="{Binding Settings}"
                    Visibility="{Binding DataContext.IsSettingsActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
